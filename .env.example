# ==========================================
# 长线项目 · 环境变量配置（模板）
# 使用方法：复制本文件为 .env，填入你自己的密钥后运行
#   cp .env.example .env
# ==========================================

# ===== 主引擎：本地 Ollama FinGPT（免费、金融垂直） =====
# Ollama 服务地址（默认本地）
OLLAMA_URL=http://localhost:11434
# FinGPT 模型名（你 ollama 里已装的）
FINGPT_MODEL=modelscope.cn/second-state/FinGPT-MT-Llama-3-8B-LoRA-GGUF:latest

# 中译英翻译模型（官方 qwen3:8b，稳定可靠）
TRANSLATE_MODEL=qwen3:8b

# ===== 兜底引擎：DeepSeek 云端 API（FinGPT 失败时才用） =====
# DeepSeek API Key（在 https://platform.deepseek.com 申请）
# 填入你自己的 sk-xxx
DEEPSEEK_API_KEY=你的_DeepSeek_Key

# DeepSeek 接口地址（官方默认，无需改动）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型（deepseek-chat 性价比最高）
DEEPSEEK_MODEL=deepseek-chat

# ===== Alpaca 模拟盘（Paper Trading） =====
# 在 https://alpaca.markets 注册，获取 Paper Trading 的 Key
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY_ID=你的_Alpaca_Key_ID
ALPACA_API_SECRET_KEY=你的_Alpaca_Secret_Key

# ===== 历史新闻/情绪回填源（真实情绪序列） =====
# Alpha Vantage 免费 key（https://www.alphavantage.co/support/#api-key 注册，25次/天）
ALPHA_VANTAGE_API_KEY=你的_AlphaVantage_Key

# Finnhub 免费 key（https://finnhub.io/register 注册，60次/分钟）
FINNHUB_API_KEY=你的_Finnhub_Key
